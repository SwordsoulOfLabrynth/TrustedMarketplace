# ==============================================================================
# TrustedMarketplace — Production Environment Variables Configuration Template
# COPY this file to .env.production on your deployment server.
# NEVER commit .env.production or disclose real production secrets.
# ==============================================================================

# Database Settings (PostgreSQL 16)
POSTGRES_DB=trusted_marketplace_prod
POSTGRES_USER=tm_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_RANDOM_PASSWORD_MIN_24_CHARS

# ASP.NET Core Security & JWT Authentication
# JWT Key MUST be at least 32 characters (256 bits)
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARACTERS_LONG
ASPNETCORE_ENVIRONMENT=Production

# Public Frontend & Backend URLs
NEXT_PUBLIC_API_URL=https://api.trustedmarketplace.mm
FRONTEND_ORIGIN=https://trustedmarketplace.mm

# Optional: NVIDIA NIM Multilingual Embedding Inference
# If left blank, the platform automatically utilizes the zero-dependency in-process concept-hash engine
NVIDIA_API_KEY=

# Storage Settings
STORAGE_PROVIDER=Local
# If using S3/Cloudflare R2 for multi-instance deployments:
# STORAGE_PROVIDER=S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_BUCKET_NAME=
