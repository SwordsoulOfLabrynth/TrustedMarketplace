{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=trusted_marketplace_dev;Username=postgres;Password=postgres_dev_password"
  },
  "Jwt": {
    "Issuer": "TrustedMarketplace",
    "Audience": "TrustedMarketplaceClient",
    "Key": "PLACEHOLDER_DEV_SECRET_KEY_MIN_32_CHARS_DO_NOT_USE_IN_PROD",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "LocalPrivateRoot": "./storage/private_evidence",
    "LocalPublicRoot": "./storage/public_media"
  },
  "Identity": {
    "RequireConfirmedEmail": true
  },
  "PlatformPayments": {
    "KBZPay": {
      "AccountName": "TrustedMarketplace Operations",
      "AccountPhone": "09798881234",
      "QrCodeUrl": "/images/payments/kbzpay-platform-qr.svg"
    },
    "WavePay": {
      "AccountName": "TrustedMarketplace Operations",
      "AccountPhone": "09977889900",
      "QrCodeUrl": "/images/payments/wavepay-platform-qr.svg"
    }
  }
}
